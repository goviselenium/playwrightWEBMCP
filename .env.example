# Environment Configuration for AI Playwright WebMCP Framework

# Target URL for tests (overridden by CLI --url option)
TARGET_URL=http://localhost:8000/demo/demo_app.html

# Local Ollama endpoint and configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2:latest

# Browser execution options
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# WebMCP validation options
WEBMCP_STRICT_SCHEMA_MODE=true
WEBMCP_LOG_LEVEL=INFO
